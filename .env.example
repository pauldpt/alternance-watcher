# 1) Token API La bonne alternance
# Cree un compte sur https://api.apprentissage.beta.gouv.fr/fr/compte/profil
# puis genere un jeton d'acces.
LBA_API_TOKEN=COLLE_TON_TOKEN_ICI

# 2) Zone de recherche
# Par defaut les fichiers arrivent ici.
OUTPUT_DIR=/Users/paul/Documents/Offres Alternance

# Local par defaut: SQLite dans OUTPUT_DIR.
# Cloud/GitHub Actions: mets une URL PostgreSQL/Supabase dans DATABASE_URL.
# Exemple Supabase: postgresql://postgres.xxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
REQUIRE_PERSISTENT_DB=false

# Pour toute la France, laisse SEARCH_DEPARTEMENTS vide.
# Exemples: 75,92,93,94 pour Paris proche banlieue ; 59 pour Lille ; 69 pour Lyon.
SEARCH_DEPARTEMENTS=75,92,93,94,91,78,77,95

# Option alternative aux departements: recherche autour d'un point GPS.
# SEARCH_LATITUDE=48.8566
# SEARCH_LONGITUDE=2.3522
# SEARCH_RADIUS_KM=80

# BUT3 / Licence / Bac+3 = niveau europeen 6.
TARGET_DIPLOMA_LEVEL=6

# Codes ROME orientes informatique, infra, data, cloud.
ROME_CODES=M1801,M1802,M1805,M1806,M1810,M1403

# Score minimum: baisse a 10 si tu veux plus d'offres, monte a 30 si tu veux du tres cible.
MIN_SCORE=18

# Active une recherche large en plus des ROME. Peut ramener plus de bruit.
INCLUDE_BROAD_SEARCH=false

# 3) Plateformes sans LinkedIn
# La Bonne Alternance est interrogee par API. Pour JobTeaser, WTTJ, Indeed et
# les sites carrieres, le script ajoute des liens de recherche dans le rapport.
INCLUDE_EXTERNAL_LINKS=true
INCLUDE_DIRECT_CAREERS=true
EXTERNAL_SEARCH_LOCATION=France
EXTERNAL_SEARCH_QUERIES=alternance devops cloud,alternance data engineer,alternance infrastructure cloud

# 4) Email SMTP
# Exemple Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=ton.email@gmail.com, SMTP_PASSWORD=mot de passe d'application.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=mot_de_passe_application
EMAIL_FROM=ton.email@gmail.com
EMAIL_TO=ton.email@gmail.com

# 5) Discord
# Cree un webhook dans le salon Discord cible, puis colle l'URL ici.
# Plusieurs salons: separe les webhooks par une virgule.
DISCORD_WEBHOOK_URL=COLLE_TON_WEBHOOK_DISCORD_ICI
# DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/...,https://discord.com/api/webhooks/...
DISCORD_USERNAME=Veille Alternance
# Optionnel: mentionne ton user ou un role. Exemple: <@123456789> ou <@&123456789>
DISCORD_MENTION=
DISCORD_MAX_OFFERS=10
DISCORD_BATCH_SIZE=5
